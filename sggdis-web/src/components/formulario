/* ============================================================================
   ESTILOS UNIFICADOS PARA FORMULARIOS DE INSPECCIÓN
   Archivo único para todas las secciones (A, B, C, D, E, F, G)
   ============================================================================ */

:root {
  --azul-oscuro: #021A53;
  --azul-medio: #002E7A;
  --azul-acero: #164687;
  --dorado: #CFAC65;
  --gris: #C1C5C8;
  --blanco: #FFFFFF;
  --verde: #1E7B34;
  --rojo: #B3261E;
  --amarillo: #B98900;
  --amarillo-fondo: #FFF7E0;
}

/* ============================================================================
   RESET Y ESTILOS BASE
   ============================================================================ */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
}

/* ============================================================================
   CONTENEDOR PRINCIPAL
   ============================================================================ */

.pagina {
  font-family: 'Segoe UI', Inter, Helvetica, Baskerville, sans-serif;
  background: var(--azul-oscuro);
  min-height: 100vh;
  padding-bottom: 24px;
}

/* ============================================================================
   ENCABEZADO
   ============================================================================ */

.cabecera {
  background: var(--blanco);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 24px;
  border-bottom: 3px solid var(--azul-medio);
  flex-wrap: wrap;
  gap: 12px;
}

.cabecera__marca {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cabecera__logo {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--dorado);
  color: var(--azul-oscuro);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.8rem;
}

.cabecera__marca h1 {
  font-size: 1rem;
  margin: 0;
  color: var(--azul-oscuro);
}

.cabecera__marca p {
  font-size: 0.75rem;
  margin: 0;
  color: #5b6470;
}

.cabecera__estado {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* ============================================================================
   CHIPS (ETIQUETAS PEQUEÑAS)
   ============================================================================ */

.chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 0.75rem;
  font-weight: 600;
}

.chip--alerta {
  background: var(--amarillo-fondo);
  color: var(--amarillo);
  border: 1px solid var(--amarillo);
}

.chip--info {
  background: #E8F0FE;
  color: var(--azul-acero);
  border: 1px solid var(--azul-acero);
}

.chip--puntos {
  background: #EEF1F4;
  color: var(--azul-oscuro);
}

/* ============================================================================
   NAVEGACIÓN PRINCIPAL (TABS)
   ============================================================================ */

.tabs {
  display: flex;
  gap: 8px;
  background: var(--blanco);
  padding: 8px 24px;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--gris);
}

.tabs__item {
  font-size: 0.8rem;
  padding: 6px 14px;
  border-radius: 999px;
  color: #5b6470;
  cursor: default;
}

.tabs__item--activo {
  background: var(--azul-oscuro);
  color: var(--blanco);
  font-weight: 600;
}

/* ============================================================================
   NAVEGACIÓN SECUNDARIA (SUBTABS - Para secciones B y C)
   ============================================================================ */

.subtabs {
  display: flex;
  gap: 8px;
  max-width: 860px;
  margin: 16px auto 0;
  padding: 0 24px;
  flex-wrap: wrap;
}

.subtabs__item {
  border: 1px solid var(--gris);
  background: var(--blanco);
  color: var(--azul-oscuro);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 10px 10px 0 0;
  cursor: pointer;
  transition: all 0.3s ease;
}

.subtabs__item:hover {
  border-color: var(--azul-acero);
}

.subtabs__item--activo {
  background: var(--azul-acero);
  color: var(--blanco);
  border-color: var(--azul-acero);
}

/* ============================================================================
   TARJETA PRINCIPAL (CONTENEDOR DE FORMULARIO)
   ============================================================================ */

.tarjeta {
  background: var(--blanco);
  max-width: 860px;
  margin: 0 auto 24px;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.tarjeta__encabezado {
  margin-bottom: 24px;
}

.tarjeta__etiqueta {
  color: var(--azul-acero);
  font-weight: 700;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
}

.tarjeta__titulo-fila {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 16px;
}

.tarjeta__titulo-fila h2 {
  color: var(--azul-oscuro);
  font-size: 1.4rem;
  margin: 4px 0 0 0;
  flex: 1;
}

/* ============================================================================
   TARJETA DE ESTADO (Para carga y errores)
   ============================================================================ */

.tarjeta-estado {
  max-width: 480px;
  margin: 64px auto;
  background: var(--blanco);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(2, 26, 83, 0.18);
  overflow: hidden;
}

.estado-mensaje {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 28px 24px;
  font-size: 15px;
  color: var(--azul-oscuro);
}

.estado-mensaje__icono {
  font-size: 22px;
  flex-shrink: 0;
}

.estado-mensaje--error {
  color: #B00020;
}

/* ============================================================================
   GRUPOS DE ÍTEMS
   ============================================================================ */

.grupo {
  margin-top: 24px;
}

.grupo:first-of-type {
  margin-top: 0;
}

.grupo__etiqueta {
  display: inline-block;
  background: #EEF1F4;
  color: var(--azul-oscuro);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 6px;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

/* ============================================================================
   ITEMS (PREGUNTAS/CRITERIOS DE INSPECCIÓN)
   ============================================================================ */

.item {
  border: 1px solid var(--gris);
  border-radius: 10px;
  padding: 12px 16px;
  margin-bottom: 12px;
  transition: all 0.2s ease;
}

.item:hover {
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.item--critico {
  background: var(--amarillo-fondo);
  border-color: var(--amarillo);
}

.item--pendiente {
  border-color: var(--rojo);
  box-shadow: 0 0 0 1px var(--rojo);
  background-color: #fdf5f5;
}

.item__tag {
  display: inline-block;
  background: var(--amarillo);
  color: var(--blanco);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
  margin-bottom: 8px;
}

.item__fila {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.item__texto {
  flex: 1;
  min-width: 200px;
}

.item__texto p {
  margin: 0 0 4px 0;
  color: var(--azul-oscuro);
  font-size: 0.9rem;
  line-height: 1.5;
}

.item__valor {
  font-size: 0.75rem;
  color: #5b6470;
  font-weight: 500;
}

/* ============================================================================
   OPCIONES DE RESPUESTA (Cumple, No cumple, N/A)
   ============================================================================ */

.item__opciones {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.opcion {
  border: 1px solid var(--gris);
  background: var(--blanco);
  color: #5b6470;
  padding: 6px 12px;
  border-radius: 999px;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 500;
  transition: all 0.2s ease;
}

.opcion:hover {
  border-color: var(--azul-acero);
  background-color: #f5f7fa;
}

.opcion--activa.opcion--cumple {
  background: #E6F4EA;
  color: var(--verde);
  border-color: var(--verde);
  font-weight: 600;
}

.opcion--activa.opcion--no-cumple {
  background: #FBEAE9;
  color: var(--rojo);
  border-color: var(--rojo);
  font-weight: 600;
}

.opcion--activa.opcion--na {
  background: #EEF1F4;
  color: var(--azul-oscuro);
  border-color: var(--azul-oscuro);
  font-weight: 600;
}

/* ============================================================================
   SELECTOR DE PUNTOS (Para respuestas "Cumple")
   ============================================================================ */

.item__puntos {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px dashed var(--gris);
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.item__puntos-label {
  font-size: 0.78rem;
  color: #5b6470;
  font-weight: 600;
}

.item__puntos-opciones {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.punto-opcion {
  border: 1px solid var(--gris);
  background: var(--blanco);
  color: var(--azul-oscuro);
  padding: 4px 10px;
  border-radius: 999px;
  cursor: pointer;
  font-size: 0.75rem;
  font-weight: 500;
  transition: all 0.2s ease;
}

.punto-opcion:hover {
  border-color: var(--azul-acero);
}

.punto-opcion--activa {
  background: var(--azul-acero);
  color: var(--blanco);
  border-color: var(--azul-acero);
  font-weight: 600;
}

/* ============================================================================
   ADVERTENCIAS Y MENSAJES
   ============================================================================ */

.item__advertencia {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  background: #FFF1C2;
  border-radius: 8px;
  padding: 8px 12px;
  margin: 8px 0 0 0;
  font-size: 0.78rem;
  color: #7a5b00;
  line-height: 1.4;
}

/* --- Mensajes de validación y progreso --- */

.mensaje-progreso-validacion {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  background-color: var(--amarillo-fondo);
  border: 1px solid var(--dorado);
  border-radius: 8px;
  color: #7a5b00;
  font-size: 0.88rem;
  margin-bottom: 20px;
  font-weight: 500;
}

.mensaje-progreso-validacion--completo {
  background-color: #E6F4EA;
  border-color: var(--verde);
  color: var(--verde);
}

.alerta-validacion-error {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px 18px;
  background-color: #fcebeb;
  border-left: 5px solid var(--rojo);
  border-radius: 8px;
  color: var(--rojo);
  font-size: 0.9rem;
  margin-bottom: 20px;
  animation: shake 0.3s ease-in-out;
}

.alerta-validacion-error__titulo {
  font-weight: 700;
  font-size: 0.95rem;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

/* ============================================================================
   PIE DE PÁGINA (NAVEGACIÓN)
   ============================================================================ */

.pie {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24px;
  color: var(--blanco);
  font-size: 0.85rem;
  font-weight: 500;
  gap: 16px;
  flex-wrap: wrap;
}

.pie span {
  flex-shrink: 0;
}

/* ============================================================================
   BOTONES
   ============================================================================ */

.boton {
  border: none;
  border-radius: 8px;
  padding: 10px 20px;
  font-size: 0.85rem;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s ease;
}

.boton--primario {
  background: var(--azul-acero);
  color: var(--blanco);
}

.boton--primario:hover:not(:disabled) {
  background: var(--azul-medio);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(2, 26, 83, 0.2);
}

.boton--primario:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.boton--secundario {
  background: transparent;
  color: var(--blanco);
  border: 1px solid var(--blanco);
}

.boton--secundario:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-2px);
}

.boton--secundario:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ============================================================================
   RESPONSIVE DESIGN
   ============================================================================ */

@media (max-width: 768px) {
  .cabecera {
    padding: 12px 16px;
  }

  .cabecera__marca h1 {
    font-size: 0.9rem;
  }

  .tarjeta {
    margin: 12px;
    padding: 16px;
  }

  .tarjeta__titulo-fila {
    flex-direction: column;
  }

  .tarjeta__titulo-fila h2 {
    font-size: 1.1rem;
  }

  .item__fila {
    flex-direction: column;
    align-items: flex-start;
  }

  .item__opciones {
    width: 100%;
  }

  .pie {
    padding: 0 16px;
    flex-direction: column;
    gap: 12px;
  }

  .pie > span {
    text-align: center;
    width: 100%;
  }

  .tabs {
    padding: 8px 16px;
  }

  .subtabs {
    padding: 0 16px;
  }
}

@media (max-width: 480px) {
  .cabecera__marca {
    flex-direction: column;
    width: 100%;
  }

  .cabecera__logo {
    width: 36px;
    height: 36px;
    font-size: 0.7rem;
  }

  .tarjeta {
    margin: 8px;
    padding: 12px;
  }

  .tabs {
    gap: 4px;
    padding: 6px 12px;
  }

  .tabs__item {
    font-size: 0.7rem;
    padding: 4px 10px;
  }

  .boton {
    padding: 8px 16px;
    font-size: 0.8rem;
  }

  .item__puntos-opciones {
    width: 100%;
  }

  .punto-opcion {
    flex: 1;
    min-width: 35px;
    text-align: center;
  }

  .alerta-validacion-error {
    font-size: 0.85rem;
    padding: 12px 14px;
  }
}
